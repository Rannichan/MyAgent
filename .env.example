# Backend
APP_HOST=127.0.0.1
APP_PORT=8765
APP_PUBLIC_URL=http://127.0.0.1:8765
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Model provider: vllm or llamacpp
MODEL_PROVIDER=vllm

# vLLM OpenAI-compatible endpoint
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY

# llama.cpp server OpenAI-compatible endpoint
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_API_KEY=EMPTY

# Defaults used by the UI and API if no override is sent
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_P=0.9
DEFAULT_MAX_TOKENS=2048
DEFAULT_STREAM=true
DEFAULT_THINKING=false
DEFAULT_TOOLS=false
